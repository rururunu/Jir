<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows takes DPI awareness from the manifest and from nowhere else. With no
  manifest the process counts as DPI-unaware, so on a scaled display Windows
  stretches the finished window as one bitmap: crisp at 100%, blurred at 125%
  and above. Declaring the setting here — together with AutoScaleMode on the
  forms, which grows the controls to match — is what makes the installer draw at
  native pixels.

  Only the 2005 `dpiAware` element is used. Per-monitor v2 would additionally
  need the WinForms `DpiAwareness` app.config key, and this installer ships as a
  single file with no .config beside it.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="jir.setup" version="1.0.0.0" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- Elevation still happens at run time, via a runas relaunch -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 7 through 11, so the version helpers report the real OS -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
